; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="the-legend-of-taro"
run/main_scene="res://content/levels/03_screen_navigation.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

VisualEffects="*uid://6fsty8cc28nd"
PlayerHud="*uid://dclu8eu4ausns"
Audio="*uid://4gdpjf6wjaax"

[display]

window/size/viewport_width=320
window/size/viewport_height=176
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://assets/": "yellow",
"res://content/": "orange",
"res://entities/": "green",
"res://player/": "red",
"res://systems/": "blue",
"res://ui/": "pink"
}

[global_group]

player=""

[gui]

theme/custom_font="uid://boduvm3bwoxdh"

